<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap"
  rel="stylesheet">
  <script src="https://unpkg.com/@phosphor-icons/web"></script>
  <link rel="stylesheet" href="/css/base/global.css">
  <!-- Configurações do App (PWA) -->
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#0B0710">
  <link rel="icon" type="image/png" href="/assets/logo-192.png">
  
  <!-- Registrando o Service Worker para liberar a instalação -->
  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js')
          .then(registration => {
            console.log('✨ Mágica do PWA ativada!', registration.scope);
          })
          .catch(err => {
            console.log('Falha no PWA: ', err);
          });
      });
    }
  </script>