<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">

<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/pages/login.css">
  <title>Redefinir Palavra-passe - Rimufic</title>
</head>

<body>
  <a href="/login" class="brand back-link">
    <i class="ph ph-arrow-left"></i> Voltar ao Login
  </a>

  <main class="login-wrapper">
    <div class="login-card glass">
      
      <header class="login-header">
        <div class="brand-logo">
          <i class="ph ph-shield-check"></i>
        </div>
        <h1>Nova Palavra-passe</h1>
        <p>Escolha uma nova palavra-chave segura para seu acesso.</p>
      </header>

      <% if (locals.error) { %>
        <div class="alert-box alert-error">
          <i class="ph ph-warning-circle"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <form action="/reset-password" method="POST" class="auth-form" id="resetForm">
        <input type="hidden" name="token" id="tokenInput" value="">

        <div class="form-group">
          <label for="password">Nova Palavra-passe</label>
          <div class="input-icon-wrapper">
            <i class="ph ph-lock-key"></i>
            <input type="password" id="password" name="password" class="form-control" placeholder="Mínimo 6 caracteres" required minlength="6">
          </div>
        </div>

        <div class="form-group">
          <label for="confirmPassword">Confirme a Nova Palavra-passe</label>
          <div class="input-icon-wrapper">
            <i class="ph ph-check"></i>
            <input type="password" id="confirmPassword" name="confirmPassword" class="form-control" placeholder="Repita a palavra-passe" required minlength="6">
          </div>
        </div>

        <button type="submit" class="btn-primary btn-submit">
          Salvar Nova Senha <i class="ph ph-floppy-disk"></i>
        </button>
      </form>

    </div>
  </main>

  <script>
    // Extrai o access_token se o Supabase redirecionou via URL hash (#access_token=...)
    if (window.location.hash) {
      const hashParams = new URLSearchParams(window.location.hash.substring(1));
      const accessToken = hashParams.get('access_token');
      if (accessToken) {
        document.getElementById('tokenInput').value = accessToken;
      }
    }
  </script>
</body>

</html>
