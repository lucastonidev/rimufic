<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">

<head>
  <%- include('partials/head') %>
    <link rel="stylesheet" href="/css/pages/login.css">
    <title>Entrar - Rimufic</title>
</head>

<body>
  <!-- Podemos ou não exibir o header público aqui. 
         Geralmente páginas de login são "limpas" para manter o foco. -->
  <a href="/" class="brand back-link">
    <i class="ph ph-arrow-left"></i> Voltar ao Início
  </a>

  <main class="login-container">
    <div class="login-card glass">
      <div class="login-header">
        <div class="brand-logo">
          <i class="ph ph-book-open-text"></i>
        </div>
        <h1>O Grimório</h1>
        <p>Identifique-se para acessar o acervo mágico.</p>
      </div>

      <form action="/login" method="POST" class="login-form">
        <div class="form-group">
          <label for="email">E-mail Mágico</label>
          <div class="input-icon-wrapper">
            <i class="ph ph-envelope-simple"></i>
            <input type="email" id="email" name="email" class="form-control" placeholder="mago@rimufic.com" required>
          </div>
        </div>

        <div class="form-group">
          <label for="password">Palavra-passe</label>
          <div class="input-icon-wrapper">
            <i class="ph ph-lock-key"></i>
            <input type="password" id="password" name="password" class="form-control" placeholder="••••••••" required>
            <button type="button" class="btn-toggle-pass" aria-label="Mostrar senha">
              <i class="ph ph-eye"></i>
            </button>
          </div>
        </div>

        <div class="form-options">
          <label class="remember-me">
            <input type="checkbox" name="remember">
            <span>Manter conectado</span>
          </label>
          <a href="#" class="forgot-pass">Esqueci a senha</a>
        </div>

        <button type="submit" class="btn-primary btn-login">
          Desbloquear Acesso <i class="ph ph-key"></i>
        </button>
      </form>
    </div>
  </main>

  <script>
    // Mágica para mostrar/ocultar a senha
    document.querySelector('.btn-toggle-pass').addEventListener('click', function () {
      const passInput = document.getElementById('password');
      const icon = this.querySelector('i');

      if (passInput.type === 'password') {
        passInput.type = 'text';
        icon.classList.replace('ph-eye', 'ph-eye-slash');
      } else {
        passInput.type = 'password';
        icon.classList.replace('ph-eye-slash', 'ph-eye');
      }
    });
  </script>
</body>

</html>