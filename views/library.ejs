<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">

<head>
    <%- include('partials/head') %>
        <link rel="stylesheet" href="/css/pages/library.css">
        <title>Meus Favoritos - Rimufic</title>
</head>

<body>

    <%- include('partials/header') %>

        <main class="container">
            <div class="page-header">
                <div>
                    <h1>Sua Biblioteca Mágica</h1>
                    <p style="color: var(--text-muted);">As histórias e lendas que marcaram o seu coração.</p>
                </div>
                <div class="stats-badge" id="statsBadge">
                    <i class="ph-fill ph-books"></i>
                    <span>0 Obras Salvas</span>
                </div>
            </div>

            <!-- Abas da Biblioteca: Favoritos vs Baixados Offline -->
            <div class="library-tabs" style="display: flex; gap: 12px; margin-bottom: 2rem; border-bottom: 1px solid var(--glass-border); padding-bottom: 1rem;">
                <button class="opt-btn active" id="tabFavorites" onclick="switchLibraryTab('favorites')" style="display: inline-flex; align-items: center; gap: 8px; padding: 0.6rem 1.2rem; border-radius: 8px; cursor: pointer;">
                    <i class="ph-fill ph-heart" style="color: #EC4899;"></i> Favoritos Salvos
                </button>
                <button class="opt-btn" id="tabOffline" onclick="switchLibraryTab('offline')" style="display: inline-flex; align-items: center; gap: 8px; padding: 0.6rem 1.2rem; border-radius: 8px; cursor: pointer;">
                    <i class="ph-fill ph-cloud-check" style="color: #10B981;"></i> Baixados Offline
                </button>
            </div>
        
            <!-- O JavaScript vai injetar os cards aqui dentro -->
            <div class="story-grid" id="favoritesGrid"></div>
        
            <!-- Empty State -->
            <div class="empty-state" id="emptyState" style="display: none;">
                <i class="ph ph-ghost" id="emptyStateIcon"></i>
                <h2 id="emptyStateTitle">Sua biblioteca está vazia...</h2>
                <p id="emptyStateText">Parece que você ainda não encontrou nenhuma lenda para guardar. Explore o acervo e favorite suas histórias preferidas!</p>
                <a href="/search" class="btn-primary" id="emptyStateAction" style="width: fit-content; margin: 0 auto;">
                    <i class="ph ph-magnifying-glass"></i> Explorar Acervo
                </a>
            </div>
        </main>

        <script src="/js/components/favorites.js"></script>
        <script src="/js/main.js"></script>
</body>

</html>