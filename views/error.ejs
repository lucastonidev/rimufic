<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">

<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/pages/error.css">
  <title><%= statusCode === 404 ? 'Página Não Encontrada (404)' : 'Erro Mágico (' + statusCode + ')' %> - Rimufic</title>
</head>

<body>
  <main class="error-container">
    
    <!-- Cena animada do Mascote Mágico caminhando em loop -->
    <div class="cat-scene" aria-hidden="true">
      <i class="ph ph-sparkle magic-sparkle s1"></i>
      <i class="ph ph-sparkle magic-sparkle s2"></i>
      <i class="ph ph-sparkle magic-sparkle s3"></i>

      <svg class="cat-walk" viewBox="0 0 150 120" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Rabo com animação fluida -->
        <path class="cat-tail" d="M105 60 C125 50, 135 30, 130 18 C126 10, 120 12, 118 18 C116 26, 112 45, 98 62" fill="#7B2CBF" stroke="#9D4EDD" stroke-width="2" />
        
        <!-- Pata traseira direita -->
        <rect class="cat-leg-back-right" x="100" y="70" width="9" height="35" rx="4.5" fill="#5A189A" />
        <!-- Pata dianteira direita -->
        <rect class="cat-leg-front-right" x="62" y="70" width="9" height="35" rx="4.5" fill="#5A189A" />
        
        <!-- Corpo do gato -->
        <ellipse cx="80" cy="65" rx="36" ry="20" fill="#9D4EDD" />
        
        <!-- Pata traseira esquerda -->
        <rect class="cat-leg-back-left" x="90" y="72" width="9" height="35" rx="4.5" fill="#7B2CBF" />
        <!-- Pata dianteira esquerda -->
        <rect class="cat-leg-front-left" x="50" y="72" width="9" height="35" rx="4.5" fill="#7B2CBF" />

        <!-- Cabeça -->
        <circle cx="44" cy="48" r="18" fill="#9D4EDD" />
        
        <!-- Orelhas pontudas de gatinho mágico -->
        <polygon points="32,38 38,18 46,34" fill="#7B2CBF" stroke="#9D4EDD" stroke-width="1.5" />
        <polygon points="46,34 54,18 58,38" fill="#7B2CBF" stroke="#9D4EDD" stroke-width="1.5" />
        <polygon points="35,34 39,24 44,32" fill="#E0AAFF" />
        <polygon points="48,32 53,24 56,34" fill="#E0AAFF" />

        <!-- Olhos cintilantes -->
        <ellipse cx="38" cy="46" rx="2.5" ry="3.5" fill="#E0AAFF" />
        <ellipse cx="48" cy="46" rx="2.5" ry="3.5" fill="#E0AAFF" />
        <circle cx="39" cy="45" r="1" fill="#FFFFFF" />
        <circle cx="49" cy="45" r="1" fill="#FFFFFF" />

        <!-- Focinho e bigodes -->
        <polygon points="42,52 44,54 46,52" fill="#E0AAFF" />
        <line x1="28" y1="50" x2="36" y2="52" stroke="#C77DFF" stroke-width="1.2" stroke-linecap="round" />
        <line x1="26" y1="54" x2="35" y2="54" stroke="#C77DFF" stroke-width="1.2" stroke-linecap="round" />
        <line x1="50" y1="52" x2="58" y2="50" stroke="#C77DFF" stroke-width="1.2" stroke-linecap="round" />
        <line x1="51" y1="54" x2="60" y2="54" stroke="#C77DFF" stroke-width="1.2" stroke-linecap="round" />
        
        <!-- Coleira mágica com medalhão estelar -->
        <path d="M33 58 Q44 65 53 58" stroke="#E0AAFF" stroke-width="2.5" fill="none" />
        <circle cx="43" cy="62" r="3" fill="#FFD166" />
      </svg>
      <div class="cat-shadow"></div>
    </div>

    <div class="error-badge">
      <i class="ph ph-warning-circle"></i> CÓDIGO <%= statusCode %>
    </div>

    <h1 class="error-title">
      <% if (statusCode === 404) { %>
        Perdido na Floresta Mística
      <% } else { %>
        O Feitiço Falhou
      <% } %>
    </h1>

    <p class="error-desc">
      <% if (statusCode === 404) { %>
        O pergaminho ou história que você procurava desapareceu na névoa do tempo ou nunca existiu neste reino.
      <% } else { %>
        <%= message || 'Houve uma instabilidade nos feitiços do servidor. Nossos guardiões já foram alertados.' %>
      <% } %>
    </p>

    <div class="error-actions">
      <a href="/" class="btn-primary" style="display: inline-flex; align-items: center; gap: 8px;">
        <i class="ph ph-house"></i> Voltar ao Início
      </a>
      <a href="/library" class="btn-secondary">
        <i class="ph ph-books"></i> Explorar Biblioteca
      </a>
    </div>

  </main>
</body>

</html>
